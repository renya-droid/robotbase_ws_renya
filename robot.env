# robotbase_ws identity and runtime isolation settings.
# Change ROBOTBASE_DISPLAY_NAME when the robot receives its final name.

ROBOTBASE_DISPLAY_NAME="ココちゃん"

# Independent launcher identity; keep the original robotbase_ws launcher intact.
ROBOTBASE_LAUNCHER_NAME="ココちゃんランチャー2"
ROBOTBASE_LAUNCHER_ID="koko_launcher2"

# Stable robot command identifier. Changing this also requires renaming the
# koko_* shell aliases, so normally leave it unchanged.
ROBOTBASE_ID="koko"

# Sirius uses ROS_DOMAIN_ID=56 on this development PC. Keep this different so
# both robots can run without sharing the same ROS graph.
ROBOTBASE_ROS_DOMAIN_ID="54"

# Gazebo / RViz / SLAM / Nav2 simulation graph. Keeping simulation on a
# separate domain prevents a simulator clock from resetting real-robot nodes.
ROBOTBASE_SIM_ROS_DOMAIN_ID="67"

# Isolates Gazebo Transport when Sirius and this robot use Gazebo concurrently.
ROBOTBASE_GZ_PARTITION="koko_renya"

# TF prefix. Change this single value when a different frame namespace is needed.
# The display name and TF prefix are intentionally independent.
ROBOTBASE_TF_PREFIX="robot"

# Ethernet Hokuyo. The factory/default urg_node2 configuration uses port 10940.
ROBOTBASE_HOKUYO_IP="192.168.0.9"
ROBOTBASE_HOKUYO_PORT="10940"

# Foxglove WebSocket server. Sirius uses the standard 8765 port on this PC,
# so Koko uses 8766 to allow both bridges to run at the same time.
ROBOTBASE_FOXGLOVE_ADDRESS="127.0.0.1"
ROBOTBASE_FOXGLOVE_PORT="8766"
ROBOTBASE_FOXGLOVE_PROFILE="foxglove_view_only.yaml"
