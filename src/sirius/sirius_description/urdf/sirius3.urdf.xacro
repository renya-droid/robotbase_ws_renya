<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sirius3">

  <xacro:arg name="prefix" default=""/>
  <xacro:property name="prefix" value="$(arg prefix)"/>

  <!-- ======================================== -->
  <!-- Base Footprint (地面位置: z=0)            -->
  <!-- ======================================== -->
  <link name="${prefix}base_footprint"/>

  <!-- ======================================== -->
  <!-- Base Link (車軸中心高さ: 半径100mm = 0.100m) -->
  <!-- ======================================== -->
  <link name="${prefix}base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.435 0.30"/>
      </geometry>
      <material name="robot_body_color">
        <color rgba="0.2 0.3 0.4 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.60 0.435 0.30"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="${prefix}base_footprint_to_base_link" type="fixed">
    <parent link="${prefix}base_footprint"/>
    <child link="${prefix}base_link"/>
    <origin xyz="0.0 0.0 0.100" rpy="0 0 0"/>
  </joint>

  <!-- ======================================== -->
  <!-- LiDAR Link (地面から930mm -> base_linkから830mm) -->
  <!-- ======================================== -->
  <link name="${prefix}lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.06"/>
      </geometry>
      <material name="lidar_color">
        <color rgba="0.1 0.4 0.9 0.9"/>
      </material>
    </visual>
  </link>

  <joint name="${prefix}base_link_to_lidar_link" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}lidar_link"/>
    <!-- 地面から930mm = base_link(100mm) + 830mm -->
    <origin xyz="0.0 0.0 0.830" rpy="0 0 0"/>
  </joint>

  <!-- Laser alias frame (urg_node2等の互換用) -->
  <link name="${prefix}laser"/>
  <joint name="${prefix}lidar_link_to_laser" type="fixed">
    <parent link="${prefix}lidar_link"/>
    <child link="${prefix}laser"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Velodyne frame (Velodyne 3D LiDAR用) -->
  <link name="${prefix}velodyne"/>
  <joint name="${prefix}lidar_link_to_velodyne" type="fixed">
    <parent link="${prefix}lidar_link"/>
    <child link="${prefix}velodyne"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ======================================== -->
  <!-- IMU Link (ロボット中心)                   -->
  <!-- ======================================== -->
  <link name="${prefix}imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="imu_color">
        <color rgba="1.0 0.5 0.0 0.9"/>
      </material>
    </visual>
  </link>

  <joint name="${prefix}base_link_to_imu_link" type="fixed">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}imu_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ======================================== -->
  <!-- 車輪 (トレッド幅 435mm / 直径 200mm)        -->
  <!-- ======================================== -->
  <link name="${prefix}left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.100" length="0.04"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="${prefix}base_link_to_left_wheel" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}left_wheel"/>
    <origin xyz="0.0 0.2175 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="${prefix}right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.100" length="0.04"/>
      </geometry>
      <material name="wheel_color">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="${prefix}base_link_to_right_wheel" type="continuous">
    <parent link="${prefix}base_link"/>
    <child link="${prefix}right_wheel"/>
    <origin xyz="0.0 -0.2175 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
