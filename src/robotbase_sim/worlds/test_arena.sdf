<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robotbase_arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static><pose>0 6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.20 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.20 1.5</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static><pose>0 -6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.20 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.20 1.5</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 12.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 12.2 1.5</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.20 12.2 1.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.20 12.2 1.5</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material></visual>
      </link>
    </model>

    <model name="vertical_partition">
      <static>true</static><pose>2.0 1.2 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.50 3.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.50 3.0 1.2</size></box></geometry><material><ambient>0.75 0.25 0.15 1</ambient><diffuse>0.85 0.30 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="horizontal_partition">
      <static>true</static><pose>-2.0 -1.8 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.50 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.50 1.2</size></box></geometry><material><ambient>0.15 0.40 0.70 1</ambient><diffuse>0.18 0.48 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <model name="round_obstacle">
      <static>true</static><pose>-2.8 2.6 0.60 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.60</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.60</radius><length>1.2</length></cylinder></geometry><material><ambient>0.15 0.60 0.30 1</ambient><diffuse>0.18 0.72 0.35 1</diffuse></material></visual>
      </link>
    </model>
    <model name="small_box">
      <static>true</static><pose>3.8 -3.2 0.45 0 0 0.4</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 1.0 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 1.0 0.9</size></box></geometry><material><ambient>0.60 0.45 0.10 1</ambient><diffuse>0.75 0.55 0.12 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
