<?xml version="1.0"?>
<package format="3">
  <name>restaurant_nav_experiment</name>
  <version>0.1.0</version>
  <description>Serving-robot Nav2 experiment in restaurant_sim: does knowing people's position and seated/walking state improve navigation?</description>
  <maintainer email="j7771201@gmail.com">renya</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>restaurant_sim</exec_depend>
  <exec_depend>robotbase_sim</exec_depend>
  <exec_depend>external_camera_people_layer</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
