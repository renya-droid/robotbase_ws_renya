# Copy to ~/.config/koko-face/env. Sourced only by the face launcher.
# Set the SAME ROS_DOMAIN_ID / RMW / DDS configuration as the robot.
# export ROS_DOMAIN_ID=0
# export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# export ROS_LOCALHOST_ONLY=0
# export ROBOTBASE_FACE_SCREEN=0
# ROS_SETUP=/opt/ros/jazzy/setup.bash
# KOKO_FACE_WORKSPACE_SETUP="$HOME/robotbase_ws/install/setup.bash"
